# ─── Catálogo Maestro: configuración de ejemplo ───
# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# Puerto del servidor API (la interfaz se sirve desde el mismo puerto tras `npm run build`).
PORT=4000

# Secreto para firmar sesiones/enlaces y cifrar credenciales de canales (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Base de datos PostgreSQL.
# - Si DATABASE_URL está vacía, se inicia un PostgreSQL embebido local (ideal para desarrollo en una sola PC).
# - En producción usa un PostgreSQL administrado: postgres://usuario:clave@host:5432/catalogo
DATABASE_URL=

# Carpeta de datos locales (PostgreSQL embebido + archivos subidos).
# Recomendado: fuera de carpetas sincronizadas (OneDrive/Dropbox) para evitar bloqueos y corrupción.
DATA_DIR=~/.catalogo-maestro

# URL pública con la que los marketplaces podrán descargar las fotografías de los archivos de exportación.
# Mercado Libre y TikTok Shop requieren URLs de imagen accesibles públicamente (no "localhost").
PUBLIC_BASE_URL=

# ─── Inteligencia artificial (opcional) ───
# Sin API key, la plataforma funciona con captura manual e importación; las funciones de IA se muestran como no configuradas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Nivel de esfuerzo del modelo: low | medium | high
AI_EFFORT=low
# Análisis simultáneos por lote
AI_CONCURRENCY=3

# ─── Datos de demostración (opcional: npm run seed) ───
# Solo se usan si la base no tiene usuarios. Nunca uses estos valores en producción.
DEMO_ADMIN_EMAIL=demo@catalogo.local
DEMO_ADMIN_PASSWORD=
